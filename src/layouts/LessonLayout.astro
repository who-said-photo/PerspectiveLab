---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Recommendation from "../components/Recommendation.astro";
interface Props {
  title: string;
  description: string;
  category?: string;
}
const { title, description, category = "Field notes" } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Breadcrumb title={title} />
  <div class="lesson-grid">
    <article>
      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <slot />
    </article>
    <aside class="sidebar">
      <h2>Explore the lab</h2>
      <a href="/perspective-simulator/">Perspective simulator</a>
      <a href="/how-perspective-works/">How perspective works</a>
      <a href="/camera-distance-perspective/">Camera distance</a>
      <a href="/focal-length-vs-perspective/">Focal length vs perspective</a>
      <a href="/landscape-perspective/">Landscape perspective</a>
      <Recommendation />
    </aside>
  </div>
</BaseLayout>
