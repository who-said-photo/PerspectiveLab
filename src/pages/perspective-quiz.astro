---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Quiz from "../components/Quiz.astro";
import Recommendation from "../components/Recommendation.astro";
---

<BaseLayout
  title="Perspective quiz"
  description="Test your photography perspective knowledge with 15 questions on camera position, focal length, scale, camera height and landscape decisions. Get explanations and lesson recommendations."
>
  <Breadcrumb title="Perspective quiz" />
  <div class="learning-intro">
    <p class="eyebrow">Check your understanding</p>
    <h1>Perspective final exam</h1>
    <p class="lead">
      Answer 15 questions about viewpoint and framing. Submit each answer for an
      explanation, then review any earlier answer as you go.
    </p>
    <p>
      Choose one answer per question. Submitted answers are locked for this
      attempt; restart whenever you want a fresh attempt.
    </p>
  </div>
  <Quiz />
  <div class="learning-reading">
    <h2>What the exam covers</h2>
    <p>
      Three questions each cover camera position, focal length and near-to-far
      scale. Two questions each cover camera height, landscape scenarios and
      common misconceptions. You do not need a particular camera or lens to take
      part.
    </p>
    <h2>How to read your score</h2>
    <ul>
      <li>13–15: Perspective understood</li>
      <li>10–12: Good understanding</li>
      <li>7–9: Developing</li>
      <li>0–6: Start with the simulator</li>
    </ul>
    <p>
      Missed topics point to relevant lessons. A score measures these technical
      questions, not your creativity as a photographer.
    </p>
    <p>
      <a href="/how-perspective-works/">Read how perspective works</a>
      {" or "}
      <a href="/perspective-challenges/">practise the challenges</a> before you
      begin.
    </p>
    <Recommendation />
  </div>
</BaseLayout>
