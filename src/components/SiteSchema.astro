---
interface Props {
  article?: { title: string; description: string; section: string };
}
const { article } = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const organizationId = "https://whosaidphotography.com/#organization";
const personId = "https://whosaidphotography.com/#person";
const website = {
  "@type": "WebSite",
  name: "Photography Perspective Lab",
  description:
    "Learn how camera position and focal length affect landscape photographs through lessons, a perspective simulator, challenges and a quiz.",
  inLanguage: "en-CA",
  publisher: { "@id": organizationId },
  author: { "@id": personId },
  ...(Astro.site
    ? { "@id": new URL("#website", Astro.site).href, url: Astro.site.href }
    : {}),
};
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    website,
    ...(article
      ? [
          {
            "@type": "Article",
            headline: article.title,
            description: article.description,
            articleSection: article.section,
            inLanguage: "en-CA",
            author: { "@id": personId },
            publisher: { "@id": organizationId },
            ...(canonical && Astro.site
              ? {
                  "@id": `${canonical}#article`,
                  url: canonical,
                  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
                  isPartOf: { "@id": new URL("#website", Astro.site).href },
                }
              : {}),
          },
        ]
      : []),
    {
      "@type": "Person",
      "@id": personId,
      name: "Bob Wild",
      affiliation: { "@id": organizationId },
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Who Said Photography",
      url: "https://whosaidphotography.com/",
      sameAs: [
        "https://www.facebook.com/WhoSaidPhotography",
        "https://twitter.com/whosaidphoto",
        "https://www.instagram.com/whosaidphotography/",
        "https://www.youtube.com/@WhoSaidPhotography",
      ],
    },
  ],
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")}
></script>
