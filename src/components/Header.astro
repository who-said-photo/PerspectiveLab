---
const links = [
  { href: "/perspective-simulator/", label: "Simulator" },
  { href: "/how-perspective-works/", label: "Learn" },
  { href: "/perspective-challenges/", label: "Challenges" },
  { href: "/perspective-quiz/", label: "Quiz" },
  { href: "/perspective-resources/", label: "Resources" },
];
const active = (href: string) => Astro.url.pathname === href;
---

<a class="skip" href="#main">
  Skip to content
</a>
<header class="site-header wrap">
  <a class="brand" href="/" aria-label="Photo Exhibits: Photography Perspective Lab home">
    <img src="/images/photo-exhibits-logo.png" width="2016" height="780"
      alt="Photo Exhibits: Photography Perspective Lab" />
  </a>
  <nav class="desktop-nav" aria-label="Primary">
    {links.map((link) => (
      <a href={link.href} aria-current={active(link.href) ? "page" : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
  <details class="mobile-nav">
    <summary>Menu</summary>
    <nav aria-label="Mobile primary">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={active(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </details>
</header>
