---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  redirectTo?: string;
}
const { title, description, noindex = false, redirectTo } = Astro.props;
const socialImage = Astro.site ? new URL("/images/depth-study-clean.webp", Astro.site) : undefined;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<title>{title.startsWith("Photography Perspective Lab") ? title : `${title} | Photography Perspective Lab`}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}
{redirectTo && <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
{socialImage && (
  <>
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1774" />
    <meta property="og:image:height" content="887" />
    <meta property="og:image:alt" content="Three hikers at near, middle and far distances beside a waterfall demonstrate photography perspective." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
  </>
)}
<meta property="og:locale" content="en_CA" />
<meta property="og:site_name" content="Photography Perspective Lab" />
{canonical && <meta property="og:url" content={canonical} />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
